<%- include('partials/header') %>
<%- include('partials/column-styles') %>

<section class="hero-section">
    <div class="container mx-auto text-center">
        <% if (lang === 'en') { %>
        <h1 class="section-title text-4xl md:text-5xl font-bold mb-8 text-[#0F172A]">Unique Column</h1>
        <p class="text-xl max-w-3xl mx-auto text-[#2F3B40]">
            Expert and practical insights on intellectual property rights.<br>
            Covering patents, trademarks, design, AI patents, overseas filing, and more.
        </p>
        <% } else { %>
        <h1 class="section-title text-4xl md:text-5xl font-bold mb-8 text-[#0F172A]">유니크 칼럼</h1>
        <p class="text-xl max-w-3xl mx-auto text-[#2F3B40]">
            지식재산권에 관한 전문적이고 실용적인 정보를 제공합니다.<br>
            특허, 상표, 디자인부터 AI 특허, 해외 출원까지 다양한 주제를 다룹니다.
        </p>
        <% } %>
    </div>
</section>

<% const postsToShow = 8; %>

<% categories.forEach(category => {
    const categoryPosts = posts.filter(p => p.category === category.id);
%>
<section class="py-20" style="background-color: <%= category.bgColor %>;">
    <div class="container mx-auto">
        <h2 class="section-title text-3xl font-bold mb-12"><%= lang === 'en' ? category.titleEn : category.title %></h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <% if (categoryPosts.length > 0) { %>
                <% categoryPosts.slice(0, postsToShow).forEach(post => { %>
                    <%- include('partials/column-card', { post, lang }) %>
                <% }) %>
            <% } else { %>
                <p class="col-span-full text-gray-500">
                    <%= lang === 'en' ? 'No posts in this category yet.' : '해당 카테고리의 게시물이 없습니다.' %>
                </p>
            <% } %>
        </div>
        <% if (categoryPosts.length > postsToShow) { %>
        <div class="text-center mt-12">
            <a href="/column/<%= category.id %>" class="btn-more">
                <%= lang === 'en' ? `See all posts (${categoryPosts.length}) →` : `이전 자료 보기 (전체 ${categoryPosts.length}개) →` %>
            </a>
        </div>
        <% } %>
    </div>
</section>
<% }); %>

<%- include('partials/footer') %>
