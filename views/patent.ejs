                    <tr style="border-top:1px solid #e5e7eb;"><td class="p-4 font-bold">등록 기준</td><td class="p-4">기존 기술보다 진보한 발명</td><td class="p-4">기준이 조금 완화된 고안</td></tr>
                    <tr style="border-top:1px solid #e5e7eb;"><td class="p-4 font-bold">존속 기간</td><td class="p-4">출원일부터 20년</td><td class="p-4">출원일부터 10년</td></tr>
                    <tr style="border-top:1px solid #e5e7eb;"><td class="p-4 font-bold">이런 경우 추천</td><td class="p-4">핵심 기술, 소프트웨어·BM, 장기간 보호가 필요한 기술</td><td class="p-4">생활용품·부품의 구조 개선, 제품 수명이 짧은 경우</td></tr>
                </tbody>
            </table>
        </div>
        <p class="text-center mt-6" style="color:#2F3B40;">어느 쪽이 유리한지는 무료 상담에서 함께 판단해 드립니다. 기능은 실용신안, 모양은 디자인으로 함께 보호하는 방법도 있습니다.</p>
    </div>
</section>

<!-- 해외출원 -->
<section class="py-16" style="background:#EDFBE2;">
    <div class="container mx-auto px-4">
        <h2 class="section-title text-3xl font-bold text-center w-full">해외 특허 출원 (PCT · 개별국)</h2>
        <p class="text-center mt-2 mb-10" style="color:#2F3B40;word-break:keep-all;">수출이나 해외 판매를 계획하고 있다면, 국내 출원일부터 <b>12개월</b> 안에 해외 출원을 결정해야 우선권을 주장할 수 있습니다.</p>
        <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto" style="word-break:keep-all;">
            <div class="p-8" style="background:#fff;border:1px solid #e5e7eb;border-radius:8px;box-shadow:0 4px 12px rgba(15,23,42,.05);">
                <h3 class="text-2xl font-bold mb-3" style="color:#0F172A;">PCT 국제출원</h3>
                <p class="leading-relaxed" style="color:#2F3B40;">한 번의 국제출원으로 여러 나라에 출원한 효과를 얻고, 우선일부터 30개월(국가에 따라 31개월) 안에 실제로 진출할 나라를 정할 수 있습니다. 진출국이 아직 정해지지 않았을 때 시간을 버는 방법입니다.</p>
            </div>
            <div class="p-8" style="background:#fff;border:1px solid #e5e7eb;border-radius:8px;box-shadow:0 4px 12px rgba(15,23,42,.05);">
                <h3 class="text-2xl font-bold mb-3" style="color:#0F172A;">개별국 출원</h3>
                <p class="leading-relaxed" style="color:#2F3B40;">미국, 중국, 일본처럼 진출할 나라가 한두 곳으로 정해져 있다면 각 나라에 바로 출원하는 편이 비용과 기간 면에서 유리할 수 있습니다.</p>
            </div>
        </div>
        <p class="text-center mt-6" style="color:#2F3B40;">해외 출원 비용은 국가와 번역 분량에 따라 달라 상담 후 안내드립니다. 해외 출원도 정부지원사업으로 비용 일부를 지원받을 수 있습니다.</p>
    </div>
</section>

<%
    const patentFaqs = [
        { q: '특허 등록까지 얼마나 걸리나요?', a: '심사 대기 기간은 기술 분야와 특허청 상황에 따라 다릅니다. 제품 출시나 투자 일정 때문에 빨리 결과가 필요하면 우선심사를 신청해 일반 심사보다 훨씬 빨리 결과를 받을 수 있습니다. 상담할 때 지금 기준 예상 기간을 안내드립니다.' },
        { q: '제품을 이미 판매하거나 공개했는데 출원할 수 있나요?', a: '공개한 날부터 12개월 안이면 공지예외주장을 해서 출원할 수 있는 경우가 있습니다. 다만 해외는 인정 범위가 나라마다 달라 불리할 수 있으니, 공개했다면 가능한 한 빨리 상담받으세요.' },
        { q: '청구항 수가 늘면 비용이 달라지나요?', a: '네. 특허청에 내는 심사청구료와 등록료는 청구항 수에 따라 늘어납니다. 대리인 수수료는 기술 난이도와 명세서 분량에 따라 달라지며, 출원 전에 항목별로 미리 안내드립니다.' }
    ];
%>
<script type="application/ld+json"><%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: patentFaqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
}).replace(/</g, '\\u003c') %></script>
<style>.svc-faq summary{list-style:none}.svc-faq summary::-webkit-details-marker{display:none}.svc-faq .faq-chevron{transition:transform .15s}.svc-faq[open] .faq-chevron{transform:rotate(180deg)}</style>
<section class="py-16" style="background:#f9fafb;">
    <div class="container mx-auto px-4">
        <h2 class="section-title text-3xl font-bold text-center w-full">특허 출원 자주 묻는 질문</h2>
        <div class="max-w-3xl mx-auto space-y-3 mt-10" style="word-break:keep-all;">
            <% patentFaqs.forEach((f, i) => { %>
            <details class="svc-faq bg-white rounded-lg shadow-sm" <%= i === 0 ? 'open' : '' %>>
                <summary class="flex items-start gap-3 p-5 cursor-pointer font-medium" style="color:#0F172A;">
                    <span class="font-bold" style="color:#54B435;">Q</span><span class="flex-1"><%= f.q %></span>
                    <i class="fas fa-chevron-down text-gray-300 text-sm mt-1 faq-chevron"></i>
                </summary>
                <div class="flex items-start gap-3 px-5 pb-5 leading-relaxed" style="color:#2F3B40;">
                    <span class="text-gray-400 font-bold">A</span><p class="flex-1"><%= f.a %></p>
                </div>
            </details>
            <% }) %>
        </div>
    </div>
</section>
<% } %>

