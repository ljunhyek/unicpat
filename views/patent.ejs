<%- include('partials/header') %>

<style>
    .hero { position: relative; padding: 8rem 0 4rem 0; background: linear-gradient(135deg, #e9eff1 0%, #d8e1e6 100%); margin-top: -80px; overflow: hidden; }
    .hero-content { position: relative; z-index: 10; text-align: center; }
    .hero-content h1 { color: #0F172A; }
    .hero-content p { color: #2F3B40; }
    .section-title { position: relative; display: inline-block; margin-bottom: 1.5rem; font-weight: 700; color: #0F172A; }
    .section-title::after { content: ''; position: absolute; bottom: -8px; left: 50%; width: 60px; height: 3px; background: #54B435; transform: translateX(-50%); }
    .service-card { background: white; border-radius: 8px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); transition: transform 0.3s, box-shadow 0.3s; border: 1px solid #e5e7eb; }
    .service-card:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(84, 180, 53, 0.15); }
    .service-icon { width: 60px; height: 60px; background: #f0fdf4; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; }
    .service-icon i { font-size: 24px; color: #54B435; }
    .process-step { background: white; border-radius: 8px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); position: relative; border-left: 4px solid #54B435; }
    .process-number { width: 40px; height: 40px; background: #54B435; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; position: absolute; left: -22px; top: 20px; }
    .cost-table { background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
    .cost-table th { background: #54B435; color: white; padding: 1rem; text-align: left; font-weight: 600; }
    .cost-table td { padding: 1rem; border-bottom: 1px solid #e5e7eb; }
    .cost-table tr:last-child td { border-bottom: none; }
    .btn-primary { background: #54B435; color: white; padding: 0.75rem 1.5rem; border-radius: 5px; font-weight: 500; transition: background 0.3s; display: inline-block; text-decoration: none; }
    .btn-primary:hover { background: #469b2d; color: white; }
    .btn-outline { border: 2px solid #54B435; color: #54B435; padding: 0.75rem 1.5rem; border-radius: 5px; font-weight: 500; transition: background 0.3s, color 0.3s; display: inline-block; text-decoration: none; }
    .btn-outline:hover { background: #54B435; color: white; }
    .case-card { background: white; border-radius: 8px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); overflow: hidden; border: 1px solid #e5e7eb; }
    .case-header { background: linear-gradient(135deg, #54B435 0%, #16a34a 100%); color: white; padding: 1rem; }
</style>

<!-- 히어로 -->
<section class="hero flex items-center justify-center">
    <div class="container mx-auto z-10">
        <div class="hero-content">
            <% if (lang === 'en') { %>
            <h1 class="text-4xl md:text-5xl font-bold mb-4">Patent / Utility Model Application</h1>
            <p class="text-lg my-6 max-w-3xl mx-auto">The first step to protecting your ideas and succeeding in business.<br>Unic Patent will help you secure your rights firmly.</p>
            <% } else { %>
            <h1 class="text-4xl md:text-5xl font-bold mb-4">특허/실용신안 출원</h1>
            <p class="text-lg my-6 max-w-3xl mx-auto" style="word-break:keep-all;"><b>특허, 등록 가능성부터 확인하고 시작하세요</b><br>선행기술조사로 등록 가능성을 먼저 살피고, 사업에 맞는 청구항을 설계합니다.<br class="hidden md:block"> 비용은 출원 전에 항목별로 안내합니다.</p>
            <% } %>
        </div>
    </div>
</section>

<!-- 중요성 섹션 -->
<section class="py-16 bg-white">
    <div class="container mx-auto">
        <% if (lang === 'en') { %>
        <h2 class="section-title text-3xl font-bold text-center">Why Is Patent / Utility Model Application Important?</h2>
