<%- include('partials/header') %>

<style>
    .post-header {
        padding-top: 120px;
        padding-bottom: 56px;
        margin-top: -80px;
        background-color: #EDFBE2;
    }
    .post-body p { line-height: 1.95; margin-bottom: 1.25rem; word-break: keep-all; }
    .post-points li { position: relative; padding-left: 1.5rem; line-height: 1.8; word-break: keep-all; }
    .post-points li::before { content: ''; position: absolute; left: 0.25rem; top: 0.7rem; width: 6px; height: 6px; border-radius: 50%; background: #54B435; }
    .btn-primary { background: #54B435; color: white; padding: 0.75rem 1.5rem; border-radius: 5px; font-weight: 500; transition: background 0.3s; display: inline-block; }
    .btn-primary:hover { background: #469b2d; }
    .btn-outline { border: 1px solid #54B435; color: #3d8a25; padding: 0.75rem 1.5rem; border-radius: 5px; font-weight: 500; display: inline-block; transition: background 0.3s; }
    .btn-outline:hover { background: #EDFBE2; }
</style>

<% if (preview) { %>
<div class="bg-yellow-100 text-yellow-800 text-sm text-center py-2 relative z-10" style="margin-top: 0;">
    관리자 미리보기입니다. <%= post.summary_ready ? '현재 홈페이지에 공개된 글입니다.' : '아직 공개되지 않았습니다.' %>
</div>
<% } %>

<article>
    <header class="post-header">
        <div class="container mx-auto max-w-3xl">
            <a href="/column" class="text-sm text-[#3d8a25] hover:underline"><%= en ? 'Unique Column' : '유니크 칼럼' %></a>
            <span class="text-sm text-gray-400 mx-1">›</span>
            <span class="text-sm text-gray-500"><%= categoryName %></span>
            <h1 class="text-2xl md:text-3xl font-bold text-[#0F172A] mt-4 leading-snug" style="word-break: keep-all;"><%= postTitle %></h1>
            <p class="text-sm text-gray-500 mt-4">
                <%= en ? 'Junhyek Lee, Patent Attorney, Unic Patent Firm' : '유니크 특허사무소 이준혁 변리사' %>
                <% if (post.published_on) { %> · <%= String(post.published_on).replace(/-/g, '.') %><% } %>
            </p>
        </div>
    </header>

    <div class="container mx-auto max-w-3xl py-12">
        <div class="post-body text-[#2F3B40] text-base md:text-lg">
            <% paragraphs.forEach(p => { %><p><%= p %></p><% }) %>
        </div>

        <% if (keyPoints.length) { %>
        <section class="bg-white rounded-lg shadow-sm p-6 mt-8">
            <h2 class="text-lg font-bold text-[#0F172A] mb-4"><%= en ? 'Key Points' : '핵심 정리' %></h2>
            <ul class="post-points space-y-2 text-[#2F3B40]">
                <% keyPoints.forEach(k => { %><li><%= k %></li><% }) %>
            </ul>
        </section>
        <% } %>

        <% if (checkpoint) { %>
        <section class="border-l-4 border-[#54B435] pl-5 py-1 mt-8">
            <p class="text-xs font-bold tracking-widest text-[#3d8a25] mb-2">UNIC CHECKPOINT</p>
            <p class="text-[#2F3B40] leading-relaxed" style="word-break: keep-all;"><%= checkpoint %></p>
        </section>
        <% } %>

        <div class="flex flex-wrap gap-3 mt-10">
            <% if (!en) { %>
                <a href="<%= post.url %>" target="_blank" rel="noopener" class="btn-primary">블로그에서 전체 글 읽기 ↗</a>
                <a href="/contact" class="btn-outline">상담 문의하기</a>
            <% } else { %>
                <a href="/contact" class="btn-primary">Contact Us</a>
                <a href="/column" class="btn-outline">More Columns</a>
            <% } %>
        </div>
        <p class="text-xs text-gray-400 mt-4 leading-relaxed">
            <%= en
                ? 'This summary is for general information only. Specific cases may be assessed differently depending on the facts. It is based on Korean law as of the publication date.'
                : '이 글은 일반적인 정보 제공을 위한 요약이며, 구체적인 사안은 사실관계에 따라 판단이 달라질 수 있습니다.' %>
        </p>

        <% if (related.length) { %>
        <section class="mt-14">
            <h2 class="text-lg font-bold text-[#0F172A] mb-4"><%= en ? 'Related Columns' : '함께 읽으면 좋은 글' %></h2>
            <div class="space-y-3">
                <% related.forEach(r => { %>
                <a href="<%= r.href %>"<%- r.internal ? '' : ' target="_blank" rel="noopener noreferrer"' %> class="block bg-white rounded-lg shadow-sm p-4 hover:shadow-md transition-shadow">
                    <span class="font-medium text-[#0F172A]"><%= r.displayTitle %></span>
                </a>
                <% }) %>
            </div>
        </section>
        <% } %>
    </div>
</article>

<%- include('partials/footer') %>
