<%- include('partials/header') %>

<style>
    .unsubscribe-section {
        padding-top: 10rem;
        padding-bottom: 10rem;
        margin-top: -80px;
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .btn-primary {
        background: #54B435;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 5px;
        font-weight: 500;
        transition: background 0.3s;
        display: inline-block;
    }
    .btn-primary:hover {
        background: #469b2d;
    }
</style>

<div class="unsubscribe-section text-center bg-gray-50">
    <div class="container mx-auto px-4">
        <div class="max-w-lg mx-auto bg-white p-10 rounded-lg shadow-lg">
            <% if (state === 'confirm') { %>
                <i class="fas fa-envelope text-6xl text-gray-400 mb-6"></i>
                <h1 class="text-3xl font-bold text-[#0F172A] mb-4">뉴스레터 수신거부</h1>
                <p class="text-lg text-gray-700 mb-8">
                    유니크 특허 인사이트 뉴스레터를 더 이상 받지 않으시겠습니까?
                </p>
                <form action="/unsubscribe" method="POST">
                    <input type="hidden" name="t" value="<%= token %>">
                    <button type="submit" class="btn-primary w-full sm:w-auto">수신거부하기</button>
                </form>
            <% } else if (state === 'done') { %>
                <i class="fas fa-check-circle text-6xl text-green-500 mb-6"></i>
                <h1 class="text-3xl font-bold text-[#0F172A] mb-4">수신거부가 완료되었습니다.</h1>
                <p class="text-lg text-gray-700 mb-8">
                    <% if (email) { %><b><%= email %></b> 주소로<br><% } %>
                    더 이상 뉴스레터가 발송되지 않습니다.<br>그동안 구독해 주셔서 감사합니다.
                </p>
                <a href="/" class="btn-primary w-full sm:w-auto">홈으로 돌아가기</a>
            <% } else if (state === 'test') { %>
                <i class="fas fa-flask text-6xl text-blue-500 mb-6"></i>
                <h1 class="text-3xl font-bold text-[#0F172A] mb-4">테스트 메일의 수신거부 링크입니다.</h1>
                <p class="text-lg text-gray-700 mb-8">
                    링크는 정상적으로 연결되었습니다.<br>
                    실제 발송 메일에서는 받는 분마다 고유한 링크가 들어가며,<br>누르면 바로 수신거부 처리됩니다.
                </p>
                <a href="/" class="btn-primary w-full sm:w-auto">홈으로 돌아가기</a>
            <% } else { %>
                <i class="fas fa-exclamation-circle text-6xl text-yellow-500 mb-6"></i>
                <h1 class="text-3xl font-bold text-[#0F172A] mb-4">수신거부 링크가 올바르지 않습니다.</h1>
                <p class="text-lg text-gray-700 mb-8">
                    메일에 회신하시거나 ljunhyek@naver.com 으로<br>수신거부를 요청해 주시면 바로 처리해 드리겠습니다.
                </p>
                <a href="/" class="btn-primary w-full sm:w-auto">홈으로 돌아가기</a>
            <% } %>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
