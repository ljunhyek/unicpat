                <a href="https://www.ipbot1.com" target="_blank" class="flex items-center justify-center bg-green-600 p-4 rounded-lg shadow-lg text-white hover:bg-green-700 transition">
                    <i class="fas fa-robot mr-3"></i>
                    <span>Real-time IP Management</span>
                </a>
            </div>
            <% } else { %>
