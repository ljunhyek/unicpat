                        <i class="fas fa-comments mr-3"></i>
                        <span>무료 상담 신청</span>
                    </a>
                    <a href="tel:032-288-7960" class="flex items-center justify-center bg-white/80 backdrop-blur-sm p-4 rounded-lg shadow-lg text-gray-800 hover:bg-white transition">
                        <i class="fas fa-phone-alt mr-3 text-green-600"></i>
                        <span>전화상담 032-288-7960</span>
                    </a>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <a href="https://blog.naver.com/unicpat" target="_blank" rel="noopener" class="flex items-center justify-center bg-white/80 backdrop-blur-sm p-4 rounded-lg shadow-lg text-gray-800 hover:bg-white transition">
                        <i class="fas fa-blog mr-3 text-green-600"></i>
                        <span>유니크 블로그</span>
                    </a>
                    <a href="https://www.ipbot1.com" target="_blank" class="flex items-center justify-center bg-white/80 backdrop-blur-sm p-4 rounded-lg shadow-lg text-gray-800 hover:bg-white transition">
                        <i class="fas fa-search mr-3 text-green-600"></i>
                        <span>내 특허 연차료 조회</span>
                    </a>
                </div>
            </div>
            <% } %>
        </div>
    </div>
</section>


