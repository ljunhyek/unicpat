<%# 서비스 페이지 하단의 인천 지역 안내 (한국어만). include('partials/incheon-note', { service: '특허·실용신안 출원' }) %>
<% if (lang !== 'en') { %>
<section class="py-12 bg-white">
    <div class="container mx-auto">
        <div class="max-w-3xl mx-auto rounded-lg p-8" style="background:#f9fafb;border:1px solid #e5e7eb;border-left:4px solid #54B435;word-break:keep-all;">
            <p class="text-sm font-bold mb-2" style="color:#3d8a25;letter-spacing:.05em;">인천 지역 <%= service %> 상담</p>
            <h2 class="text-2xl font-bold mb-4" style="color:#0F172A;">인천 청라에서 변리사가 직접 상담합니다</h2>
            <p class="leading-relaxed mb-3" style="color:#2F3B40;">
                유니크 특허사무소는 인천 청라에 있는 특허사무소입니다. 청라·송도·남동·부평·검단 등 인천 지역 기업과 스타트업의 <%= service %>을 20년 경력의 이준혁 변리사가 처음부터 끝까지 직접 맡습니다.
            </p>
            <p class="leading-relaxed mb-6" style="color:#2F3B40;">
                인천테크노파크와 각종 정부지원사업 연계 서비스도 제공해, 출원 비용 부담을 줄일 수 있는 방법을 함께 찾아 드립니다. 전화·메일 상담은 인천 어디서나 가능하고, 예약하시면 청라 사무실에서 대면 상담을 받으실 수 있습니다.
            </p>
            <div class="flex flex-wrap gap-3">
                <a href="/incheon" class="font-bold px-5 py-3 rounded" style="background:#54B435;color:#fff;">인천 특허사무소 안내 보기</a>
                <a href="/location" class="font-bold px-5 py-3 rounded" style="background:#fff;color:#16a34a;border:2px solid #54B435;">찾아오시는 길</a>
            </div>
        </div>
    </div>
</section>
<% } %>
