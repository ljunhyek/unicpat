<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Noto Sans KR', sans-serif; }</style>
</head>
<body class="bg-gray-100">
<%
    const fmt = ts => ts ? new Date(ts).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul', month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
    const rate = total ? Math.round(opened / total * 100) : 0;
    const tab = (f, label) => `<a href="?f=${f}" class="px-3 py-1 rounded-full text-sm ${filter === f ? 'bg-purple-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-200'}">${label}</a>`;
%>
<div class="max-w-5xl mx-auto px-4 py-8">
    <a href="/admin/dashboard#tab-mailing" class="text-sm text-blue-600 hover:underline"><i class="fas fa-arrow-left mr-1"></i>뉴스레터 발송으로 돌아가기</a>

    <h1 class="text-2xl font-bold mt-4">열람 현황</h1>
    <p class="text-gray-600 mt-1">(광고) <%= campaign.subject %></p>

    <% if (error) { %>
        <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 p-4 rounded-lg text-sm mt-6"><%= error %></div>
    <% } else { %>

    <div class="grid grid-cols-3 gap-3 mt-6">
        <div class="bg-white rounded-lg p-4 shadow-sm">
            <div class="text-xs text-gray-500">발송 성공</div>
            <div class="text-2xl font-bold"><%= total.toLocaleString() %></div>
        </div>
        <div class="bg-white rounded-lg p-4 shadow-sm">
            <div class="text-xs text-purple-600">열람</div>
            <div class="text-2xl font-bold text-purple-700"><%= opened.toLocaleString() %></div>
        </div>
        <div class="bg-white rounded-lg p-4 shadow-sm">
            <div class="text-xs text-gray-500">열람률</div>
            <div class="text-2xl font-bold"><%= rate %>%</div>
        </div>
    </div>

    <p class="text-xs text-gray-500 mt-3 leading-relaxed">
        메일 속 이미지가 표시될 때 열람으로 기록됩니다. 이미지를 차단한 메일함에서 읽으면 기록되지 않고,
        일부 메일 서비스(애플 메일 등)는 열지 않아도 이미지를 미리 받아 열람으로 잡힐 수 있어 참고용 수치입니다.
        열람 기록 기능을 추가하기 전에 보낸 메일은 기록되지 않습니다.
    </p>

    <div class="flex gap-2 mt-6">
        <%- tab('all', `전체 ${total}`) %>
        <%- tab('opened', `열람 ${opened}`) %>
        <%- tab('unopened', `미열람 ${total - opened}`) %>
    </div>

    <div class="bg-white rounded-lg shadow-sm mt-3 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 text-gray-600 text-xs">
                <tr>
                    <th class="px-4 py-3">회사</th>
                    <th class="px-4 py-3">이메일</th>
                    <th class="px-4 py-3">발송</th>
                    <th class="px-4 py-3">처음 열람</th>
                    <th class="px-4 py-3">최근 열람</th>
                    <th class="px-4 py-3 text-right">열람 횟수</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                <% if (rows.length) { %>
                    <% rows.forEach(r => { %>
                    <tr class="<%= r.opened_at ? '' : 'text-gray-400' %>">
                        <td class="px-4 py-2"><%= r.subscriber && r.subscriber.company_name || '' %></td>
                        <td class="px-4 py-2"><%= r.email %></td>
                        <td class="px-4 py-2 whitespace-nowrap"><%= fmt(r.sent_at) %></td>
                        <td class="px-4 py-2 whitespace-nowrap"><%= r.opened_at ? fmt(r.opened_at) : '미열람' %></td>
                        <td class="px-4 py-2 whitespace-nowrap"><%= fmt(r.last_opened_at) %></td>
                        <td class="px-4 py-2 text-right"><%= r.open_count || '' %></td>
                    </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="6" class="px-4 py-6 text-center text-gray-400">해당하는 수신자가 없습니다.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
    <% } %>
</div>
</body>
</html>
