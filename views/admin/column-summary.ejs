<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Noto Sans KR', sans-serif; }</style>
</head>
<body class="bg-gray-100">
<div class="max-w-4xl mx-auto px-4 py-8">
    <a href="/admin/dashboard#tab-column" class="text-sm text-blue-600 hover:underline"><i class="fas fa-arrow-left mr-1"></i>칼럼 관리로 돌아가기</a>

    <h1 class="text-2xl font-bold mt-4">칼럼 글 편집</h1>
    <p class="text-gray-600 mt-1"><%= post.title %></p>
    <p class="text-sm mt-1"><a href="<%= post.url %>" target="_blank" class="text-blue-600 hover:underline">블로그 원문 보기 ↗</a></p>

    <% if (saved) { %>
        <div class="bg-green-50 border border-green-200 text-green-800 p-3 rounded-lg text-sm mt-4">저장했습니다.</div>
    <% } %>
    <% if (!postNo) { %>
        <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 p-3 rounded-lg text-sm mt-4">블로그 주소가 blog.naver.com/unicpat/글번호 형식이 아니어서 홈페이지 글 페이지를 만들 수 없습니다.</div>
    <% } %>

    <form method="POST" class="bg-white rounded-lg shadow-sm p-6 mt-6 space-y-5">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">제목 <span class="text-gray-400 font-normal">(홈페이지 칼럼 목록·글 페이지에 보이는 제목)</span></label>
            <input type="text" name="title" value="<%= post.title || '' %>" class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <%
            // 썸네일 + 긴 글 본문 칸 (한국어 sfx='', 영어 sfx='_en')
            const articleFields = (sfx, label) => {
                const thumbSrc = post['thumbnail' + sfx] ? '/admin/columns/' + post.id + '/thumbnail' + (sfx ? '?lang=en' : '') : '';
        %>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1"><%= label %>썸네일 <span class="text-gray-400 font-normal">(1200×630 JPG/PNG. 본문의 {{thumbnail}} 자리와 공유 미리보기에 쓰입니다)</span></label>
            <div class="flex flex-wrap items-start gap-4">
                <img id="thumbPreview<%= sfx %>" src="<%= thumbSrc %>" alt="" class="rounded border <%= thumbSrc ? '' : 'hidden' %>" style="width:300px;height:auto;">
                <div class="text-sm space-y-2">
                    <input type="file" class="js-thumb-file" data-sfx="<%= sfx %>" accept="image/jpeg,image/png,image/webp">
                    <input type="hidden" name="thumbnail<%= sfx %>" id="thumbData<%= sfx %>">
                    <% if (thumbSrc) { %><label class="flex items-center gap-2"><input type="checkbox" name="thumbnail<%= sfx %>_remove" value="1"> 썸네일 삭제</label><% } %>
                </div>
            </div>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1"><%= label %>본문 (긴 글 HTML) <span class="text-gray-400 font-normal">— h2/h3/p/ul/ol/table/blockquote/strong 사용, 맨 위 {{thumbnail}} 그림</span></label>
            <textarea name="body_html<%= sfx %>" rows="22" class="w-full border rounded-lg px-3 py-2 text-xs font-mono leading-relaxed focus:outline-none focus:ring-2 focus:ring-blue-500"><%= post['body_html' + sfx] || '' %></textarea>
        </div>
        <% } %>
        <% if ('body_html' in post) { articleFields('', ''); } else { %>
        <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 p-3 rounded-lg text-sm">
            긴 글 본문·썸네일 칸을 쓰려면 Supabase SQL Editor에서 <code>supabase/column_article.sql</code>을 실행해 주세요.
        </div>
        <% } %>
        <% if (!post.body_html) { %>
        <!-- 예전 요약 방식 (긴 글 본문이 없는 칼럼만 사용) -->
        <details class="border rounded-lg p-4" <%= post.summary ? 'open' : '' %>>
            <summary class="text-sm font-semibold cursor-pointer">예전 요약 방식 <span class="font-normal text-gray-500">— 긴 글 본문이 없을 때만 화면에 보입니다</span></summary>
            <div class="space-y-4 mt-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">요약 <span class="text-gray-400 font-normal">(빈 줄로 문단 구분)</span></label>
                    <textarea name="summary" rows="10" class="w-full border rounded-lg px-3 py-2 text-sm leading-relaxed"><%= post.summary || '' %></textarea>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">핵심 정리 <span class="text-gray-400 font-normal">(한 줄에 하나씩)</span></label>
                    <textarea name="key_points" rows="5" class="w-full border rounded-lg px-3 py-2 text-sm leading-relaxed"><%= post.key_points || '' %></textarea>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">UNIC CHECKPOINT <span class="text-gray-400 font-normal">(한 문장)</span></label>
                    <input type="text" name="checkpoint" value="<%= post.checkpoint || '' %>" class="w-full border rounded-lg px-3 py-2 text-sm">
                </div>
            </div>
        </details>
        <% } %>
        <% if ('faq' in post) { %>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">자주 묻는 질문 <span class="text-gray-400 font-normal">('Q. 질문' 다음 줄에 'A. 답변', 질문끼리는 빈 줄로 구분. 비워 두면 표시하지 않습니다.)</span></label>
            <textarea name="faq" rows="10" placeholder="Q. 질문을 적어 주세요&#10;A. 답변을 적어 주세요&#10;&#10;Q. 두 번째 질문&#10;A. 두 번째 답변" class="w-full border rounded-lg px-3 py-2 text-sm leading-relaxed focus:outline-none focus:ring-2 focus:ring-blue-500"><%= post.faq || '' %></textarea>
        </div>
        <% } else { %>
        <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 p-3 rounded-lg text-sm">
            '자주 묻는 질문' 칸을 쓰려면 Supabase SQL Editor에서 <code>supabase/column_faq_1.sql</code>을 실행해 주세요.
        </div>
        <% } %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">카테고리</label>
                <select name="category" class="w-full border rounded-lg px-3 py-2 text-sm">
                    <% [['strategy', '전략'], ['patent', '특허'], ['trademark', '상표·디자인']].forEach(([v, label]) => { %>
                        <option value="<%= v %>" <%= post.category === v ? 'selected' : '' %>><%= label %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">블로그 발행일</label>
                <input type="date" name="published_on" value="<%= post.published_on || '' %>" class="w-full border rounded-lg px-3 py-2 text-sm">
            </div>
            <label class="flex items-center gap-2 mt-6 text-sm">
                <input type="checkbox" name="summary_ready" value="1" <%= post.summary_ready ? 'checked' : '' %> <%= postNo ? '' : 'disabled' %> class="h-4 w-4">
                <span><b>홈페이지에 공개</b> <span class="text-gray-500">— 칼럼 목록이 블로그 대신 이 글 페이지로 연결됩니다</span></span>
            </label>
        </div>
        <% const hasEn = !!(post.body_html_en || post.summary_en); %>
        <details class="border rounded-lg p-4" <%= hasEn ? '' : 'open' %>>
            <summary class="text-sm font-semibold cursor-pointer">영어 버전 (English 메뉴에 표시) <%= hasEn ? '' : '— 아직 없음' %></summary>
            <div class="space-y-4 mt-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">영어 제목 <span class="text-gray-400 font-normal">(있어야 영어 칼럼 목록에서 이 글로 연결됩니다)</span></label>
                    <input type="text" name="title_en" value="<%= post.title_en || '' %>" class="w-full border rounded-lg px-3 py-2 text-sm">
                </div>
                <% if ('body_html_en' in post) { articleFields('_en', '영어 '); } else { %>
                <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 p-3 rounded-lg text-sm">
                    영문 긴 글·썸네일 칸을 쓰려면 Supabase SQL Editor에서 <code>supabase/column_article_en.sql</code>을 실행해 주세요.
                </div>
                <% } %>
                <% if (!post.body_html_en) { %>
                <details class="border rounded-lg p-4" <%= post.summary_en ? 'open' : '' %>>
                    <summary class="text-sm font-semibold cursor-pointer">예전 영어 요약 <span class="font-normal text-gray-500">— 영문 긴 글이 없을 때만 보입니다 (요약 / 핵심 정리 / CHECKPOINT)</span></summary>
                    <div class="space-y-4 mt-4">
                        <textarea name="summary_en" rows="8" class="w-full border rounded-lg px-3 py-2 text-sm leading-relaxed"><%= post.summary_en || '' %></textarea>
                        <textarea name="key_points_en" rows="4" class="w-full border rounded-lg px-3 py-2 text-sm leading-relaxed"><%= post.key_points_en || '' %></textarea>
                        <input type="text" name="checkpoint_en" value="<%= post.checkpoint_en || '' %>" class="w-full border rounded-lg px-3 py-2 text-sm">
                    </div>
                </details>
                <% } %>
            </div>
        </details>
        <div class="flex flex-wrap gap-3 items-center">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg text-sm">저장</button>
            <a href="/admin/columns/<%= post.id %>/preview" target="_blank" class="text-sm text-blue-600 hover:underline">저장된 내용 미리보기 ↗</a>
            <a href="/admin/columns/<%= post.id %>/preview?lang=en" target="_blank" class="text-sm text-blue-600 hover:underline">영어 미리보기 ↗</a>
            <% if (post.summary_ready && postNo) { %>
                <a href="/column/<%= postNo %>" target="_blank" class="text-sm text-green-700 hover:underline">공개 페이지 보기 ↗</a>
            <% } %>
        </div>
    </form>
</div>
<script>
// 썸네일 파일 → data URI (저장할 때 함께 전송). 한국어·영어 썸네일 공용
document.querySelectorAll('.js-thumb-file').forEach(input => input.addEventListener('change', e => {
    const file = e.target.files[0], sfx = e.target.dataset.sfx;
    if (!file) return;
    if (file.size > 1.5 * 1024 * 1024) { alert('1.5MB 이하 이미지로 올려 주세요.'); e.target.value = ''; return; }
    const reader = new FileReader();
    reader.onload = () => {
        document.getElementById('thumbData' + sfx).value = reader.result;
        const img = document.getElementById('thumbPreview' + sfx);
        img.src = reader.result;
        img.classList.remove('hidden');
    };
    reader.readAsDataURL(file);
}));
</script>
</body>
</html>
