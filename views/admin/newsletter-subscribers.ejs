<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Noto Sans KR', sans-serif; }</style>
</head>
<body class="bg-gray-100">
<%
    const fmt = ts => ts ? new Date(ts).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul', year: '2-digit', month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
    // 현재 필터·검색을 유지한 채 일부만 바꾼 주소 (기본값은 주소에서 생략)
    const link = params => {
        const p = { f: filter, field, q, ...params };
        const entries = Object.entries(p).filter(([k, v]) => v && !(k === 'f' && v === 'all') && !(k === 'field' && v === 'name') && !(k === 'page' && v === 1));
        return '?' + new URLSearchParams(entries.map(([k, v]) => [k, String(v)])).toString();
    };
    const tabs = [
        ['all', '전체', counts.total, '곳'],
        ['target', '발송 대상', counts.target, '곳'],
        ['unsent', '아직 못 받은 발송 대상', counts.unsent, '곳'],
        ['unsubscribed', '수신거부', counts.unsubscribed, '곳'],
        ['bounced', '반송·스팸 신고', counts.bounced, '곳'],
        ['opened', '열어본 사람', counts.opened, '명'],
        ['unopened', '받았지만 안 열어본 사람', counts.unopened, '명']
    ];
    const fmtDate = ts => ts ? new Date(ts).toLocaleDateString('ko-KR', { timeZone: 'Asia/Seoul', year: '2-digit', month: 'numeric', day: 'numeric' }) : '';
    const HISTORY_STATUS = { sent: '발송', pending: '대기', sending: '발송 중', failed: '실패', skipped: '제외' };
    const STATUS = { active: ['수신 가능', 'bg-green-100 text-green-700'], unsubscribed: ['수신거부', 'bg-red-100 text-red-700'], bounced: ['반송', 'bg-yellow-100 text-yellow-700'], complained: ['스팸 신고', 'bg-red-100 text-red-700'] };
%>
<div class="max-w-6xl mx-auto px-4 py-8">
    <a href="/admin/dashboard#tab-mailing" class="text-sm text-blue-600 hover:underline"><i class="fas fa-arrow-left mr-1"></i>뉴스레터 발송으로 돌아가기</a>
    <h1 class="text-2xl font-bold mt-4">구독자 관리</h1>

    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3 mt-6">
        <% tabs.forEach(([f, label, n, unit]) => { %>
        <a href="<%= link({ f, page: '' }) %>" class="rounded-lg p-4 shadow-sm <%= filter === f ? 'bg-blue-600 text-white' : 'bg-white hover:bg-gray-50' %>">
            <div class="text-xs <%= filter === f ? 'text-blue-100' : 'text-gray-500' %>"><%= label %></div>
            <div class="text-2xl font-bold"><%= n.toLocaleString() %><span class="text-sm font-normal ml-1"><%= unit %></span></div>
        </a>
        <% }) %>
    </div>
    <p class="text-xs text-gray-500 mt-2 leading-relaxed">
        발송 대상 = 수신 가능 상태인 기업인증 기업 + 홈페이지 구독 신청자. 지금까지 한 통 이상 받은 사람은 <%= counts.sentPeople.toLocaleString() %>명입니다.<br>
        반송·스팸 신고 = 없는 주소로 반송됐거나 받은 사람이 스팸 신고해 자동으로 발송 대상에서 빠진 주소(네이버·Gmail 등은 신고 정보를 알려주지 않아 일부만 잡힘).<br>
        열어본 사람 = 보낸 뉴스레터를 한 번이라도 연 사람(열람 기록 기능 추가 이후 발송분 기준), 많이 연 순. 안 열어본 사람도 발송 대상에서 빼지 않습니다(이미지 차단 메일함은 열어도 기록되지 않음). [기록]을 누르면 회차별 발송일과 열람일을 볼 수 있습니다.
    </p>

    <form method="GET" class="flex flex-wrap gap-2 mt-6">
        <input type="hidden" name="f" value="<%= filter %>">
        <select name="field" class="border rounded-lg px-3 py-2 text-sm bg-white">
            <option value="name" <%= field === 'name' ? 'selected' : '' %>>이름·회사명</option>
            <option value="email" <%= field === 'email' ? 'selected' : '' %>>이메일</option>
        </select>
        <input type="text" name="q" value="<%= q %>" placeholder="검색어" class="border rounded-lg px-3 py-2 text-sm flex-1 min-w-0">
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white rounded-lg px-4 py-2 text-sm"><i class="fas fa-search mr-1"></i>검색</button>
        <% if (q) { %><a href="<%= link({ q: '', page: '' }) %>" class="px-3 py-2 text-sm text-gray-600 hover:underline">검색 지우기</a><% } %>
    </form>

    <% if (error) { %>
        <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 p-4 rounded-lg text-sm mt-4"><%= error %></div>
    <% } %>

    <p class="text-sm text-gray-600 mt-4"><%= count.toLocaleString() %>건<% if (q) { %> · "<%= q %>" 검색 결과<% } %></p>

    <div class="bg-white rounded-lg shadow-sm mt-2 overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 text-gray-600 text-xs">
                <tr>
                    <th class="px-3 py-3">회사명</th>
                    <th class="px-3 py-3">이름</th>
                    <th class="px-3 py-3">이메일</th>
                    <th class="px-3 py-3">상태</th>
                    <th class="px-3 py-3">구분</th>
                    <th class="px-3 py-3">발송</th>
                    <th class="px-3 py-3">열람</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                <% if (!rows.length) { %>
                    <tr><td colspan="7" class="px-3 py-8 text-center text-gray-400">해당하는 구독자가 없습니다.</td></tr>
                <% } %>
                <% rows.forEach(r => { const st = STATUS[r.status] || [r.status, 'bg-gray-100 text-gray-600']; %>
                <tr class="<%= r.status !== 'active' ? 'text-gray-400' : '' %>">
                    <td class="px-3 py-2"><%= r.company_name || '' %></td>
                    <td class="px-3 py-2"><%= r.contact_name || r.ceo || '' %></td>
                    <td class="px-3 py-2"><%= r.email %></td>
                    <td class="px-3 py-2 whitespace-nowrap">
                        <span class="px-2 py-0.5 rounded text-xs <%= st[1] %>"><%= st[0] %></span>
                        <% const statusAt = { unsubscribed: r.unsubscribed_at, bounced: r.bounced_at, complained: r.complained_at }[r.status]; %>
                        <% if (statusAt) { %><div class="text-xs text-gray-400 mt-1"><%= fmt(statusAt) %></div><% } %>
                    </td>
                    <td class="px-3 py-2 text-xs whitespace-nowrap">
                        <% if (r.source === 'website_signup') { %><span class="px-2 py-0.5 rounded bg-purple-100 text-purple-700">구독 신청</span><% } %>
                        <% if (r.certification) { %><span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700" title="<%= r.certification %>">기업인증</span><% } %>
                        <% if (r.isTarget) { %><div class="text-green-700 mt-1">발송 대상</div><% } %>
                    </td>
                    <td class="px-3 py-2 whitespace-nowrap text-xs">
                        <% if (r.stats) { %>
                            <div>최근 <%= fmtDate(r.stats.lastSentAt) %></div>
                            <div class="text-gray-400"><%= r.stats.sent %>통 받음</div>
                        <% } else if (r.isTarget) { %>
                            <span class="text-orange-600">아직 못 받음</span>
                        <% } %>
                    </td>
                    <td class="px-3 py-2 whitespace-nowrap text-xs">
                        <% if (r.stats && r.stats.openedCampaigns) { %>
                            <div>최근 <%= fmt(r.stats.lastOpenedAt) %></div>
                            <div class="text-gray-400"><%= r.stats.openedCampaigns %>회차 · <%= r.stats.opens %>번</div>
                        <% } else if (r.stats) { %>
                            <span class="text-gray-400">미열람</span>
                        <% } %>
                        <% if (r.history.length) { %>
                            <button type="button" class="js-history text-blue-600 hover:underline mt-1" data-id="<%= r.id %>">기록</button>
                        <% } %>
                    </td>
                </tr>
                <% if (r.history.length) { %>
                <tr class="hidden bg-gray-50" id="history-<%= r.id %>">
                    <td colspan="7" class="px-6 py-3">
                        <table class="text-xs w-full">
                            <thead class="text-gray-500"><tr><th class="text-left py-1">회차</th><th class="text-left py-1">상태</th><th class="text-left py-1">발송일</th><th class="text-left py-1">열람일</th><th class="text-right py-1">열람 횟수</th></tr></thead>
                            <tbody>
                                <% r.history.forEach(h => { %>
                                <tr>
                                    <td class="py-1 pr-3">(광고) <%= h.subject %></td>
                                    <td class="py-1 pr-3"><%= HISTORY_STATUS[h.status] || h.status %></td>
                                    <td class="py-1 pr-3 whitespace-nowrap"><%= fmt(h.sentAt) %></td>
                                    <td class="py-1 pr-3 whitespace-nowrap"><%= h.openedAt ? fmt(h.openedAt) : (h.status === 'sent' ? '미열람' : '') %></td>
                                    <td class="py-1 text-right"><%= h.opens || '' %></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </td>
                </tr>
                <% } %>
                <% }) %>
            </tbody>
        </table>
    </div>

    <% if (pages > 1) { %>
    <div class="flex items-center justify-center gap-2 mt-4 text-sm">
        <% if (page > 1) { %><a href="<%= link({ page: page - 1 }) %>" class="px-3 py-1 bg-white rounded shadow-sm hover:bg-gray-50">이전</a><% } %>
        <span class="text-gray-600"><%= page %> / <%= pages %></span>
        <% if (page < pages) { %><a href="<%= link({ page: page + 1 }) %>" class="px-3 py-1 bg-white rounded shadow-sm hover:bg-gray-50">다음</a><% } %>
    </div>
    <% } %>
</div>
<script>
document.querySelectorAll('.js-history').forEach(btn => {
    btn.addEventListener('click', () => {
        const row = document.getElementById('history-' + btn.dataset.id);
        row.classList.toggle('hidden');
        btn.textContent = row.classList.contains('hidden') ? '기록' : '기록 닫기';
    });
});
</script>
</body>
</html>
