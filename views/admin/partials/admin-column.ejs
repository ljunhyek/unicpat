<h2 class="text-xl font-bold mb-4">유니크 칼럼 관리</h2>

<!-- 블로그에서 글 가져오기 -->
<div class="bg-green-50 border border-green-200 p-4 rounded-lg mb-6">
    <div class="flex flex-wrap items-center gap-3">
        <button type="button" id="blog-find" class="bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-lg text-sm transition-colors">
            <i class="fas fa-download mr-1"></i>블로그에서 글 가져오기
        </button>
        <span class="text-xs text-gray-600">블로그의 새 글을 찾아 제목·주소·카테고리·발행일을 채워 추가합니다. 요약이 준비되면 '검토 대기'로 바뀌고, 확인 후 체크하면 홈페이지에 게시됩니다.</span>
    </div>
    <div id="blog-new" class="hidden mt-4">
        <p id="blog-new-msg" class="text-sm mb-2"></p>
        <ul id="blog-new-list" class="text-sm space-y-1 mb-3"></ul>
        <button type="button" id="blog-import" class="hidden bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg text-sm">선택한 글 가져오기</button>
        <p id="blog-progress" class="text-sm mt-2"></p>
    </div>
</div>

<!-- 추가 폼 -->
<form action="/admin/add" method="POST" class="bg-gray-50 p-4 rounded-lg mb-6 space-y-3">
    <input type="hidden" name="type" value="column">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">제목 *</label>
            <input type="text" name="title" required
                   class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   placeholder="칼럼 제목">
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">URL *</label>
            <input type="url" name="url" required
                   class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   placeholder="https://blog.naver.com/...">
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">카테고리 *</label>
            <select name="category" required
                    class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="strategy">전략</option>
                <option value="patent">특허</option>
                <option value="trademark">상표</option>
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">이미지 경로</label>
            <input type="text" name="image"
                   class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   placeholder="/images/columns/example.png">
        </div>
    </div>
    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg text-sm transition-colors">
        <i class="fas fa-plus mr-1"></i>칼럼 추가
    </button>
</form>

<!-- 목록 -->
<div class="overflow-x-auto">
    <table class="w-full text-sm text-left">
        <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
            <tr>
                <th class="px-4 py-3">제목</th>
                <th class="px-4 py-3">카테고리</th>
                <th class="px-4 py-3">이미지</th>
                <th class="px-4 py-3">홈페이지 요약</th>
                <th class="px-4 py-3 text-center">삭제</th>
            </tr>
        </thead>
        <tbody class="divide-y">
            <% if (posts && posts.length > 0) { %>
                <% posts.forEach(post => { %>
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3">
                            <a href="<%= post.url %>" target="_blank" class="text-blue-600 hover:underline"><%= post.title %></a>
                        </td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-1 rounded text-xs font-medium
                                <% if (post.category === 'strategy') { %>bg-purple-100 text-purple-700
                                <% } else if (post.category === 'patent') { %>bg-green-100 text-green-700
                                <% } else { %>bg-yellow-100 text-yellow-700<% } %>">
                                <%= post.category === 'strategy' ? '전략' : (post.category === 'patent' ? '특허' : '상표') %>
                            </span>
                        </td>
                        <td class="px-4 py-3 text-gray-500 text-xs"><%= post.image || '-' %></td>
                        <td class="px-4 py-3 text-xs whitespace-nowrap">
                            <% if (post.summary) { %>
                                <label class="inline-flex items-center gap-1 mr-2 cursor-pointer" title="체크하면 바로 홈페이지에 공개됩니다">
                                    <input type="checkbox" class="js-column-publish h-4 w-4" data-id="<%= post.id %>" <%= post.summary_ready ? 'checked' : '' %>>
                                    <span class="js-publish-label px-2 py-0.5 rounded <%= post.summary_ready ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>"><%= post.summary_ready ? '공개' : '검토 대기' %></span>
                                </label>
                            <% } %>
                            <a href="/admin/columns/<%= post.id %>/summary" class="text-blue-600 hover:underline"><%= post.summary ? '편집' : '요약 쓰기' %></a>
                        </td>
                        <td class="px-4 py-3 text-center">
                            <form action="/admin/delete" method="POST" class="inline"
                                  onsubmit="return confirm('정말 삭제하시겠습니까?')">
                                <input type="hidden" name="type" value="column">
                                <input type="hidden" name="id" value="<%= post.id %>">
                                <button type="submit" class="text-red-500 hover:text-red-700">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr><td colspan="5" class="px-4 py-6 text-center text-gray-400">등록된 칼럼이 없습니다.</td></tr>
            <% } %>
        </tbody>
    </table>
</div>

<script>
// 블로그에서 글 가져오기: 새 글 찾기 → 선택한 글을 한 개씩 추가
(function () {
    const CATEGORY = { strategy: '전략', patent: '특허', trademark: '상표' };
    const box = document.getElementById('blog-new');
    const msg = document.getElementById('blog-new-msg');
    const list = document.getElementById('blog-new-list');
    const importBtn = document.getElementById('blog-import');
    const progress = document.getElementById('blog-progress');

    async function api(method, url, body) {
        const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: body ? JSON.stringify(body) : undefined
        });
        const json = await res.json().catch(() => ({ error: '서버 응답 오류 (HTTP ' + res.status + ')' }));
        if (!res.ok) throw new Error(json.error || '오류');
        return json;
    }

    document.getElementById('blog-find').addEventListener('click', async () => {
        box.classList.remove('hidden');
        list.innerHTML = '';
        progress.textContent = '';
        importBtn.classList.add('hidden');
        msg.className = 'text-sm mb-2 text-gray-600';
        msg.textContent = '블로그 새 글을 찾는 중…';
        try {
            const { posts } = await api('GET', '/admin/columns/blog/new');
            if (!posts.length) {
                msg.textContent = '새로 가져올 글이 없습니다. 마지막으로 등록한 글 이후 블로그에 올라온 글이 없습니다.';
                return;
            }
            msg.textContent = '마지막으로 등록한 글 이후 새 글 ' + posts.length + '개를 찾았습니다. 가져올 글을 선택하세요.';
            posts.forEach(p => {
                const li = document.createElement('li');
                li.innerHTML = '<label class="inline-flex items-start gap-2"><input type="checkbox" class="js-blog-pick mt-1" checked>' +
                    '<span><span class="text-gray-500"></span> <a target="_blank" class="text-blue-600 hover:underline"></a></span></label>';
                li.querySelector('input').dataset.no = p.no;
                li.querySelector('.text-gray-500').textContent = '[' + (p.published_on || '') + ' · ' + CATEGORY[p.category] + ']';
                const a = li.querySelector('a');
                a.href = p.url;
                a.textContent = p.title;
                list.appendChild(li);
            });
            importBtn.classList.remove('hidden');
        } catch (err) {
            msg.className = 'text-sm mb-2 text-red-600';
            msg.textContent = '새 글을 찾지 못했습니다: ' + err.message;
        }
    });

    importBtn.addEventListener('click', async () => {
        const picks = [...document.querySelectorAll('.js-blog-pick:checked')].map(b => b.dataset.no);
        if (!picks.length) return;
        importBtn.disabled = true;
        window.onbeforeunload = () => true;
        const failed = [];
        for (let i = 0; i < picks.length; i++) {
            const step = (i + 1) + '/' + picks.length;
            try {
                progress.className = 'text-sm mt-2 text-gray-700';
                progress.textContent = step + ' 글 추가 중…';
                await api('POST', '/admin/columns/blog/import', { no: picks[i] });
            } catch (err) {
                failed.push(picks[i] + ': ' + err.message);
            }
        }
        window.onbeforeunload = null;
        if (failed.length) {
            progress.className = 'text-sm mt-2 text-red-600';
            progress.textContent = '일부 글을 추가하지 못했습니다: ' + failed.join(' / ');
            importBtn.disabled = false;
        } else {
            location.hash = 'tab-column';
            location.reload();
        }
    });

})();

// 홈페이지 요약 공개 체크: 체크하는 즉시 저장되고 공개(해제하면 비공개)
document.querySelectorAll('.js-column-publish').forEach(box => {
    box.addEventListener('change', async () => {
        const label = box.nextElementSibling;
        box.disabled = true;
        try {
            const res = await fetch('/admin/columns/' + box.dataset.id + '/publish', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ready: box.checked })
            });
            const json = await res.json().catch(() => ({ error: '서버 응답 오류 (HTTP ' + res.status + ')' }));
            if (!res.ok) throw new Error(json.error || '저장 실패');
            box.checked = json.ready;
        } catch (err) {
            box.checked = !box.checked;
            alert('저장하지 못했습니다: ' + err.message);
        } finally {
            box.disabled = false;
            label.textContent = box.checked ? '공개' : '검토 대기';
            label.className = 'js-publish-label px-2 py-0.5 rounded ' + (box.checked ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700');
        }
    });
});
</script>
