<h2 class="text-xl font-bold mb-4">뉴스레터 관리</h2>

<!-- 추가 폼: 다른 곳에서 만든 뉴스레터 HTML 파일을 올리면 제목·발행일을 자동으로 읽어 목록에 추가 -->
<form action="/admin/add" method="POST" id="newsletter-upload-form" class="bg-gray-50 p-4 rounded-lg mb-6 space-y-3">
    <input type="hidden" name="type" value="newsletter">
    <textarea name="html" id="newsletter-html" class="hidden"></textarea>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">뉴스레터 HTML 파일 *</label>
            <input type="file" id="newsletter-file" accept=".html,.htm,text/html" required
                   class="w-full border rounded-lg px-3 py-1.5 text-sm bg-white">
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">제목 (비워 두면 자동)</label>
            <input type="text" name="title" id="newsletter-title"
                   class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   placeholder="파일을 고르면 자동으로 채워집니다">
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">발행일 (비워 두면 자동)</label>
            <input type="text" name="date" id="newsletter-date"
                   class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   placeholder="2026.11.16">
        </div>
    </div>
    <p class="text-xs text-gray-500">제목은 &lt;title&gt; 또는 머리글과 그 아래 소개 문장에서, 발행일은 'NOVEMBER 2026' 같은 발행 월 표기에서 읽습니다(발행 월이 이번 달이면 오늘 날짜). 이미지는 인터넷 주소로 연결된 것만 표시됩니다.</p>
    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg text-sm transition-colors">
        <i class="fas fa-upload mr-1"></i>뉴스레터 추가
    </button>
</form>
<script>
    <%- include('../../../lib/newsletter-import.js') %>

    // 관리자 화면 공용: HTML에서 읽은 제목·발행일로 입력칸 채우기 (발송 탭에서도 사용)
    window.fillFromHtml = function (html, fields) {
        const parsed = parseNewsletterHtml(html);
        if (fields.title && parsed.title) fields.title.value = parsed.title;
        if (fields.date && parsed.date) fields.date.value = parsed.date;
    };

    document.getElementById('newsletter-file').addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;
        if (file.size > 3 * 1024 * 1024) {
            alert('HTML 파일이 너무 큽니다(3MB 이하). 이미지를 파일에 넣지 말고 인터넷 주소로 연결해 주세요.');
            e.target.value = '';
            return;
        }
        const html = await file.text();
        document.getElementById('newsletter-html').value = html;
        fillFromHtml(html, { title: document.getElementById('newsletter-title'), date: document.getElementById('newsletter-date') });
    });

    document.getElementById('newsletter-upload-form').addEventListener('submit', async (e) => {
        const textarea = document.getElementById('newsletter-html');
        if (textarea.value) return;
        e.preventDefault();
        const file = document.getElementById('newsletter-file').files[0];
        if (!file) return;
        if (file.size > 3 * 1024 * 1024) {
            alert('HTML 파일이 너무 큽니다(3MB 이하). 이미지를 파일에 넣지 말고 인터넷 주소로 연결해 주세요.');
            return;
        }
        textarea.value = await file.text();
        e.target.submit();
    });
</script>

<!-- 목록 -->
<div class="overflow-x-auto">
    <table class="w-full text-sm text-left">
        <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
            <tr>
                <th class="px-4 py-3">제목</th>
                <th class="px-4 py-3">발행일</th>
                <th class="px-4 py-3 text-center">삭제</th>
            </tr>
        </thead>
        <tbody class="divide-y">
            <% if (newsletters && newsletters.length > 0) { %>
                <% newsletters.forEach(nl => { %>
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3">
                            <a href="<%= nl.link %>" target="_blank" class="text-blue-600 hover:underline"><%= nl.title %></a>
                        </td>
                        <td class="px-4 py-3 text-gray-500"><%= nl.date %></td>
                        <td class="px-4 py-3 text-center">
                            <% if (nl.sent) { %>
                            <span class="text-xs text-gray-400" title="뉴스레터 발송 탭에서 보낸 회차입니다">발송 회차</span>
                            <% } else { %>
                            <form action="/admin/delete" method="POST" class="inline"
                                  onsubmit="return confirm('정말 삭제하시겠습니까?')">
                                <input type="hidden" name="type" value="newsletter">
                                <input type="hidden" name="id" value="<%= nl.id %>">
                                <button type="submit" class="text-red-500 hover:text-red-700">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr><td colspan="3" class="px-4 py-6 text-center text-gray-400">등록된 뉴스레터가 없습니다.</td></tr>
            <% } %>
        </tbody>
    </table>
</div>
