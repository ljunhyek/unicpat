<div class="flex flex-col sm:flex-row justify-between sm:items-center mb-6 gap-3">
    <h2 class="text-xl font-bold">방문 통계</h2>
    <div class="flex gap-2 text-sm">
        <% [7, 30, 90].forEach(d => { %>
            <a href="/admin/dashboard?days=<%= d %>#tab-stats"
               class="px-3 py-1 rounded-lg border <%= stats && stats.days === d ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-gray-600 hover:bg-gray-50' %>">
                최근 <%= d %>일
            </a>
        <% }) %>
    </div>
</div>

<% if (!stats) { %>
    <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg p-4 text-sm">
        방문 통계를 불러오지 못했습니다. Supabase에 <code>page_views</code> 테이블이 만들어져 있는지 확인해 주세요.
    </div>
<% } else { %>
    <% const maxDaily = Math.max(1, ...stats.daily.map(d => d.views)); %>

    <!-- 요약 -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-gray-50 rounded-lg p-4">
            <div class="text-xs text-gray-500 mb-1">오늘 방문자</div>
            <div class="text-2xl font-bold text-gray-800"><%= stats.todayVisitors.toLocaleString() %></div>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
            <div class="text-xs text-gray-500 mb-1">오늘 페이지뷰</div>
            <div class="text-2xl font-bold text-gray-800"><%= stats.todayViews.toLocaleString() %></div>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
            <div class="text-xs text-gray-500 mb-1">최근 <%= stats.days %>일 방문자</div>
            <div class="text-2xl font-bold text-gray-800"><%= stats.totalVisitors.toLocaleString() %></div>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
            <div class="text-xs text-gray-500 mb-1">최근 <%= stats.days %>일 페이지뷰</div>
            <div class="text-2xl font-bold text-gray-800"><%= stats.totalViews.toLocaleString() %></div>
        </div>
    </div>

    <!-- 일별 추이 -->
    <div class="mb-8">
        <h3 class="font-semibold text-gray-700 mb-3">일별 페이지뷰</h3>
        <div class="flex items-end gap-px h-40 border-b border-gray-200">
            <% stats.daily.forEach(d => { %>
                <div class="flex-1 h-full flex items-end" title="<%= d.date %> · 방문자 <%= d.visitors %>명 · 페이지뷰 <%= d.views %>회">
                    <div class="w-full bg-blue-500 hover:bg-blue-700 rounded-t" style="height: <%= (d.views / maxDaily * 100).toFixed(1) %>%; min-height: <%= d.views > 0 ? 2 : 0 %>px"></div>
                </div>
            <% }) %>
        </div>
        <div class="flex justify-between text-xs text-gray-400 mt-1">
            <span><%= stats.daily[0].date.slice(5) %></span>
            <span><%= stats.daily[stats.daily.length - 1].date.slice(5) %></span>
        </div>
    </div>

    <!-- 순위 표 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <% [
            { title: '많이 본 페이지', items: stats.topPages },
            { title: '유입 경로', items: stats.topSources },
            { title: '방문 지역', items: stats.topRegions },
            { title: '기기', items: stats.devices }
        ].forEach(section => { %>
            <div>
                <h3 class="font-semibold text-gray-700 mb-3"><%= section.title %></h3>
                <% if (section.items.length === 0) { %>
                    <p class="text-sm text-gray-400">아직 데이터가 없습니다.</p>
                <% } %>
                <% section.items.forEach(item => { %>
                    <div class="mb-2">
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-700 truncate mr-2"><%= item.label %></span>
                            <span class="text-gray-500"><%= item.count.toLocaleString() %></span>
                        </div>
                        <div class="h-2 bg-gray-100 rounded">
                            <div class="h-2 bg-blue-400 rounded" style="width: <%= (item.count / section.items[0].count * 100).toFixed(1) %>%"></div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% }) %>
    </div>

    <!-- 최근 방문 기록 -->
    <h3 class="font-semibold text-gray-700 mb-3">최근 방문 기록 (50건)</h3>
    <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-100 text-gray-600 text-xs">
                <tr>
                    <th class="px-4 py-3">시간</th>
                    <th class="px-4 py-3">방문자</th>
                    <th class="px-4 py-3">페이지</th>
                    <th class="px-4 py-3">유입 경로</th>
                    <th class="px-4 py-3">지역</th>
                    <th class="px-4 py-3">기기</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                <% if (stats.recent.length === 0) { %>
                    <tr><td colspan="6" class="px-4 py-6 text-center text-gray-400">아직 방문 기록이 없습니다.</td></tr>
                <% } %>
                <% stats.recent.forEach(v => { %>
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-2 text-gray-500 whitespace-nowrap"><%= v.time %></td>
                        <td class="px-4 py-2 font-mono text-xs text-gray-500">#<%= v.visitor %></td>
                        <td class="px-4 py-2"><%= v.page %></td>
                        <td class="px-4 py-2">
                            <% if (v.referrer) { %>
                                <a href="<%= v.referrer %>" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline"><%= v.source %></a>
                            <% } else { %>
                                <%= v.source %>
                            <% } %>
                        </td>
                        <td class="px-4 py-2 text-gray-600"><%= v.region %></td>
                        <td class="px-4 py-2 text-gray-600"><%= v.device %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <p class="text-xs text-gray-400 mt-3">
        방문자 번호는 브라우저마다 무작위로 부여되는 값으로, 같은 번호는 같은 브라우저의 재방문입니다. 개인 신원(이름·IP)은 저장하지 않습니다.
    </p>
<% } %>
