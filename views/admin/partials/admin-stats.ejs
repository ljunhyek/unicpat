<%
    const fmtDiff = (n) => n === null || n === undefined ? '' : (n > 0 ? `▲ ${n.toLocaleString()}` : n < 0 ? `▼ ${Math.abs(n).toLocaleString()}` : '변동 없음');
    const diffClass = (n) => n > 0 ? 'text-green-600' : n < 0 ? 'text-red-500' : 'text-gray-400';
%>
<style>
    .stats-day summary::-webkit-details-marker { display: none; }
    .stats-day .day-chevron { transition: transform 0.15s; }
    .stats-day[open] .day-chevron { transform: rotate(90deg); }
</style>
<div class="flex flex-col sm:flex-row justify-between sm:items-center mb-6 gap-3">
    <h2 class="text-xl font-bold">방문 통계</h2>
    <div class="flex flex-wrap gap-2 text-sm">
        <% [7, 30, 90].forEach(d => { %>
            <a href="/admin/dashboard?days=<%= d %>#tab-stats"
               class="px-3 py-1 rounded-lg border <%= stats && stats.days === d ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-gray-600 hover:bg-gray-50' %>">
                최근 <%= d %>일
            </a>
        <% }) %>
        <a href="/admin/dashboard?days=<%= stats ? stats.days : 30 %>#tab-stats" class="px-3 py-1 rounded-lg border bg-white text-gray-600 hover:bg-gray-50">
            <i class="fas fa-sync-alt mr-1"></i>새로고침
        </a>
    </div>
</div>

<% if (!stats) { %>
    <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg p-4 text-sm">
        방문 통계를 불러오지 못했습니다. Supabase에 <code>page_views</code> 테이블이 만들어져 있는지 확인해 주세요.
    </div>
<% } else { %>
    <% if (!stats.hasExtraColumns) { %>
        <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg p-4 text-sm mb-6">
            신규 방문자와 뉴스레터 유입을 집계하려면 Supabase SQL Editor에서 <code>supabase/page_views_v2.sql</code>을 한 번 실행해 주세요. 실행한 다음 방문부터 기록됩니다.
        </div>
    <% } %>

    <!-- 오늘 요약 -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-blue-50 rounded-lg p-4">
            <div class="text-xs text-gray-500 mb-1">오늘 방문자</div>
            <div class="text-2xl font-bold text-gray-800"><%= stats.todayVisitors.toLocaleString() %>명</div>
            <div class="text-xs mt-1 <%= diffClass(stats.todayVisitors - stats.yesterdayVisitors) %>">
                어제 <%= stats.yesterdayVisitors.toLocaleString() %>명 · <%= fmtDiff(stats.todayVisitors - stats.yesterdayVisitors) %>
            </div>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
            <div class="text-xs text-gray-500 mb-1">오늘 페이지뷰</div>
            <div class="text-2xl font-bold text-gray-800"><%= stats.todayViews.toLocaleString() %>회</div>
            <div class="text-xs mt-1 <%= diffClass(stats.todayViews - stats.yesterdayViews) %>">
                어제 <%= stats.yesterdayViews.toLocaleString() %>회 · <%= fmtDiff(stats.todayViews - stats.yesterdayViews) %>
            </div>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
            <div class="text-xs text-gray-500 mb-1">지난 7일 하루 평균 방문자</div>
            <div class="text-2xl font-bold text-gray-800"><%= stats.avg7Visitors.toFixed(1) %>명</div>
            <div class="text-xs mt-1 text-gray-500">오늘 신규 방문자 <%= stats.hasExtraColumns ? stats.todayNewVisitors.toLocaleString() + '명' : '-' %></div>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
            <div class="text-xs text-gray-500 mb-1">최근 <%= stats.days %>일 방문자</div>
            <div class="text-2xl font-bold text-gray-800"><%= stats.totalVisitors.toLocaleString() %>명</div>
            <div class="text-xs mt-1 text-gray-500">
                페이지뷰 <%= stats.totalViews.toLocaleString() %>회 · 1인당 <%= stats.viewsPerVisitor.toFixed(1) %>페이지
            </div>
        </div>
    </div>

    <!-- 일별 방문자 추이 -->
    <% const maxDaily = Math.max(1, ...stats.daily.map(d => d.visitors)); %>
    <% const labelEvery = stats.days <= 7 ? 1 : stats.days <= 30 ? 5 : 15; %>
    <div class="mb-8">
        <div class="flex justify-between items-baseline mb-3">
            <h3 class="font-semibold text-gray-700">일별 방문자</h3>
            <span class="text-xs text-gray-400">막대에 마우스를 올리면 페이지뷰도 보입니다</span>
        </div>
        <div class="flex items-end gap-px h-44 border-b border-gray-200">
            <% stats.daily.forEach((d, i) => { const isToday = i === stats.daily.length - 1; %>
                <div class="flex-1 h-full flex flex-col justify-end items-center" title="<%= d.date %> (<%= d.weekday %>) · 방문자 <%= d.visitors %>명 · 페이지뷰 <%= d.views %>회">
                    <% if (stats.days <= 30 && d.visitors > 0) { %>
                        <span class="text-gray-500 mb-0.5" style="font-size: 10px;"><%= d.visitors %></span>
                    <% } %>
                    <div class="w-full rounded-t <%= isToday ? 'bg-blue-700' : 'bg-blue-400 hover:bg-blue-600' %>" style="height: <%= (d.visitors / maxDaily * 85).toFixed(1) %>%; min-height: <%= d.visitors > 0 ? 2 : 0 %>px"></div>
                </div>
            <% }) %>
        </div>
        <div class="flex gap-px text-gray-400 mt-1" style="font-size: 10px;">
            <% stats.daily.forEach((d, i) => { const show = (stats.daily.length - 1 - i) % labelEvery === 0; %>
                <span class="flex-1 text-center whitespace-nowrap overflow-visible"><%= show ? (i === stats.daily.length - 1 ? '오늘' : d.date.slice(5).replace('-', '/')) : '' %></span>
            <% }) %>
        </div>
    </div>

    <!-- 날짜별 현황 -->
    <div class="mb-8">
        <h3 class="font-semibold text-gray-700 mb-1">날짜별 현황</h3>
        <p class="text-xs text-gray-400 mb-3">날짜를 누르면 그날의 유입 경로와 많이 본 페이지가 펼쳐집니다. 유입 경로는 방문자 한 명당 하루 한 번만 셉니다.</p>
        <div class="overflow-x-auto">
            <div class="text-sm" style="min-width: 680px;">
                <div class="grid grid-cols-12 gap-2 bg-gray-100 text-gray-600 text-xs font-semibold px-4 py-3 rounded-t">
                    <div class="col-span-2">날짜</div>
                    <div class="col-span-1 text-right">방문자</div>
                    <div class="col-span-1 text-right">신규</div>
                    <div class="col-span-1 text-right">페이지뷰</div>
                    <div class="col-span-2 text-right">전일 대비</div>
                    <div class="col-span-2">주요 유입</div>
                    <div class="col-span-3">많이 본 페이지</div>
                </div>
                <% stats.daily.slice().reverse().forEach((d, i) => { %>
                    <details class="stats-day border-b">
                        <summary class="grid grid-cols-12 gap-2 px-4 py-2 cursor-pointer hover:bg-gray-50 list-none <%= d.visitors === 0 ? 'text-gray-400' : '' %>">
                            <div class="col-span-2 whitespace-nowrap">
                                <i class="fas fa-chevron-right text-xs text-gray-300 mr-1 day-chevron"></i>
                                <%= d.date.slice(5).replace('-', '.') %>
                                <span class="<%= d.weekday === '일' ? 'text-red-400' : d.weekday === '토' ? 'text-blue-400' : 'text-gray-400' %>">(<%= d.weekday %>)</span>
                                <% if (i === 0) { %><span class="ml-1 text-xs bg-blue-100 text-blue-700 px-1.5 rounded">오늘</span><% } %>
                            </div>
                            <div class="col-span-1 text-right font-semibold"><%= d.visitors.toLocaleString() %></div>
                            <div class="col-span-1 text-right text-gray-600"><%= stats.hasExtraColumns ? d.newVisitors.toLocaleString() : '-' %></div>
                            <div class="col-span-1 text-right text-gray-600"><%= d.views.toLocaleString() %></div>
                            <div class="col-span-2 text-right text-xs <%= diffClass(d.visitorsDiff) %>"><%= fmtDiff(d.visitorsDiff) %></div>
                            <div class="col-span-2 truncate"><%= d.visitors ? d.topSource : '-' %></div>
                            <div class="col-span-3 truncate text-gray-600" title="<%= d.topPage %>"><%= d.visitors ? d.topPage : '-' %></div>
                        </summary>
                        <% if (d.visitors > 0) { %>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 px-4 py-4 bg-gray-50">
                                <% [
                                    { title: '유입 경로 (방문자 수)', items: d.sources },
                                    { title: '많이 본 페이지 (페이지뷰)', items: d.pages }
                                ].forEach(section => { %>
                                    <div>
                                        <div class="text-xs font-semibold text-gray-500 mb-2"><%= section.title %></div>
                                        <% section.items.forEach(item => { %>
                                            <div class="flex justify-between text-sm mb-1">
                                                <span class="text-gray-700 truncate mr-2"><%= item.label %></span>
                                                <span class="text-gray-500"><%= item.count.toLocaleString() %></span>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </details>
                <% }) %>
            </div>
        </div>
    </div>

    <!-- 순위 표 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <% [
            { title: '많이 본 페이지 (페이지뷰)', items: stats.topPages },
            { title: '유입 경로 (방문자 수)', items: stats.topSources },
            { title: '방문 지역', items: stats.topRegions },
            { title: '기기', items: stats.devices }
        ].forEach(section => { %>
            <div>
                <h3 class="font-semibold text-gray-700 mb-3"><%= section.title %></h3>
                <% if (section.items.length === 0) { %>
                    <p class="text-sm text-gray-400">아직 데이터가 없습니다.</p>
                <% } %>
                <% section.items.forEach(item => { %>
                    <div class="mb-2">
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-700 truncate mr-2"><%= item.label %></span>
                            <span class="text-gray-500"><%= item.count.toLocaleString() %></span>
                        </div>
                        <div class="h-2 bg-gray-100 rounded">
                            <div class="h-2 bg-blue-400 rounded" style="width: <%= (item.count / section.items[0].count * 100).toFixed(1) %>%"></div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% }) %>
    </div>

    <!-- 최근 방문 기록 -->
    <h3 class="font-semibold text-gray-700 mb-3">최근 방문 기록 (50건)</h3>
    <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-100 text-gray-600 text-xs">
                <tr>
                    <th class="px-4 py-3">시간</th>
                    <th class="px-4 py-3">방문자</th>
                    <th class="px-4 py-3">페이지</th>
                    <th class="px-4 py-3">유입 경로</th>
                    <th class="px-4 py-3">지역</th>
                    <th class="px-4 py-3">기기</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                <% if (stats.recent.length === 0) { %>
                    <tr><td colspan="6" class="px-4 py-6 text-center text-gray-400">아직 방문 기록이 없습니다.</td></tr>
                <% } %>
                <% stats.recent.forEach(v => { %>
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-2 text-gray-500 whitespace-nowrap"><%= v.time %></td>
                        <td class="px-4 py-2 font-mono text-xs text-gray-500 whitespace-nowrap">
                            #<%= v.visitor %><% if (v.isNew) { %> <span class="font-sans text-green-600">신규</span><% } %>
                        </td>
                        <td class="px-4 py-2 max-w-xs truncate" title="<%= v.page %>"><%= v.page %></td>
                        <td class="px-4 py-2">
                            <% if (v.referrer) { %>
                                <a href="<%= v.referrer %>" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline"><%= v.source %></a>
                            <% } else { %>
                                <%= v.source %>
                            <% } %>
                        </td>
                        <td class="px-4 py-2 text-gray-600"><%= v.region %></td>
                        <td class="px-4 py-2 text-gray-600"><%= v.device %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <p class="text-xs text-gray-400 mt-3">
        방문자 번호는 브라우저마다 무작위로 부여되는 값으로, 같은 번호는 같은 브라우저의 재방문입니다. 개인 신원(이름·IP)은 저장하지 않습니다.
        관리자로 로그인한 브라우저의 방문과 검색 로봇은 통계에서 제외됩니다. 날짜는 한국 시간 기준입니다.
    </p>
<% } %>
